<Window x:Class="ProdejAutUkol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProdejAutUkol"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>
    
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
        <Button x:Name="BtnNacist" Content="Vybrat a načíst XML soubor" 
                    Padding="12,6" FontWeight="SemiBold" Click="BtnNacist_Click"/>
        <TextBlock x:Name="TxtCestaKSouboru" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Foreground="Gray" Text="Soubor nevybrán"/>
        </StackPanel>
        
        <GroupBox Grid.Row="1" Header="Všechna data načtená z XML souboru" Margin="0,0,0,10">
            <DataGrid x:Name="GridVsechnaAuta" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Název modelu" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="Datum prodeje" Binding="{Binding DatumProdeje, StringFormat=\{0:dd.MM.yyyy\}}" Width="130"/>
                    <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\} Kč}" Width="130"/>
                    <DataGridTextColumn Header="DPH" Binding="{Binding DPH, StringFormat=\{0\} %}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        
        <Separator Grid.Row="2" Margin="0,5,0,10"/>

        <GroupBox Grid.Row="3" Header="Výsledky: Celková cena vozů prodaných o víkendu (Sobota + Neděle)">
            <ListView x:Name="GridVysledky" BorderThickness="1" BorderBrush="#D0D0D0">
                <ListView.Template>
                    <ControlTemplate TargetType="ListView">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="White">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="0,0,0,1" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Název modelu" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Cena bez DPH" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="Cena s DPH" FontWeight="SemiBold" FontSize="13"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </ListView.Template>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding NazevModelu}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CenaBezDPH, StringFormat=\{0:N2\} Kč}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CenaSDPH, StringFormat=\{0:N2\} Kč}" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </GroupBox>
    </Grid>
</Window>
